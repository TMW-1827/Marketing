# Скопіюйте у .env.local і підставте значення свого проєкту Supabase:
# Project Settings → API → Project URL і anon public key.
#
# Якщо змінних немає, портал працює в автономному режимі:
# матеріали доступні, прогрес зберігається лише в цьому браузері.
#
# anon key призначений для клієнта і не є секретом — доступ до даних
# обмежують політики RLS (див. supabase/migrations/0001_init.sql).

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
